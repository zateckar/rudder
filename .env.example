# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Creates username "admin" with this password on first start.
# Once the user exists this variable is ignored — change the password in the UI.
# In development, defaults to "admin" if not set.
ADMIN_PASSWORD=yourpassword

# ── Public URL ────────────────────────────────────────────────────────────────
# External URL used in OIDC redirect URIs and generated links.
PUBLIC_URL=http://localhost:5173

# ── Origin (required behind a reverse proxy) ─────────────────────────────────
# The node adapter derives the request origin from this. Without it, SvelteKit's
# CSRF check and form actions reject requests that arrive through a proxy.
# ORIGIN=https://rudder.example.com

# ── Secrets (optional — auto-generated and persisted on first boot) ───────────
# Leave empty to let Rudder auto-generate and store it next to the database in
# ./data/.secrets.json.  Set it explicitly to keep encrypted worker credentials
# readable if you move or recreate the data directory.  Minimum 32 characters.
# ENCRYPTION_KEY=<64-char-random-string>

# ── Session ───────────────────────────────────────────────────────────────────
# SESSION_MAX_AGE=604800   # 7 days in seconds

# ── Database ──────────────────────────────────────────────────────────────────
# DATABASE_URL=file:./data/rudder.db

# ── Workers (optional) ────────────────────────────────────────────────────────
# WORKER_REGISTRATION_SECRET=<shared-secret-for-worker-self-registration>

# Allow workers to be contacted without mTLS client certificates.  Insecure —
# the Podman API is a root-equivalent interface.  Development only.
# ALLOW_INSECURE_PODMAN=true

# ── Container bind mounts ────────────────────────────────────────────────────
# Host paths that applications may bind-mount, as a colon-separated list of
# prefixes.  Unset (the default) means host mounts are refused entirely; only
# named volumes are allowed.  "/" is never accepted.
# ALLOWED_HOST_MOUNT_PREFIXES=/srv/rudder-data:/mnt/appdata

# ── OIDC providers (all optional) ────────────────────────────────────────────
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=

# OIDC_GITHUB_CLIENT_ID=
# OIDC_GITHUB_CLIENT_SECRET=

# OIDC_OKTA_CLIENT_ID=
# OIDC_OKTA_CLIENT_SECRET=
# OIDC_OKTA_DOMAIN=

# OIDC_AUTH0_CLIENT_ID=
# OIDC_AUTH0_CLIENT_SECRET=
# OIDC_AUTH0_DOMAIN=
