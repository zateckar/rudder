{
	"name": "rudder",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "bun test src",
		"verify:lifecycle": "bun scripts/verify-lifecycle.ts",
		"test:watch": "bun test --watch src",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "bun --bun drizzle-kit generate",
		"start": "set PORT=7244&& bun run server.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@types/bun": "^1.4.5",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@monaco-editor/loader": "^1.7.0",
		"@types/ws": "^8.18.2",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"drizzle-orm": "^0.45.4",
		"monaco-editor": "^0.58.0",
		"ws": "^8.23.0",
		"zod": "^4.6.7"
	}
}
