+// Authenticate ingress metadata after evaluation.
+func rudderLearningID(value, host string) string {
+	id, sig, signed := strings.Cut(value, ".")
+	if !strings.HasPrefix(id, "rudder-") {
+		return ""
+	}
+	parsed, err := uuid.Parse(strings.TrimPrefix(id, "rudder-"))
+	if err != nil || parsed.Version() != 4 || "rudder-"+parsed.String() != id {
+		return ""
+	}
+	scope := os.Getenv("RUDDER_LEARNING_HOST")
+	key := os.Getenv("RUDDER_LEARNING_INGRESS_KEY")
+	if !signed || scope == "" || len(key) < 32 || !strings.EqualFold(host, scope) {
+		return ""
+	}
+	mac := hmac.New(sha256.New, []byte(key))
+	mac.Write([]byte(id))
+	if !hmac.Equal([]byte(sig), []byte(hex.EncodeToString(mac.Sum(nil)))) {
+		return ""
+	}
+	return id
+}
